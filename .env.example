# Copy this file to ".env" and paste your real tokens there.
# ".env" is gitignored so your secrets never get committed.

# IBM Quantum — https://quantum.ibm.com  (API token + the instance CRN)
IBM_QUANTUM_TOKEN=your_ibm_token_here
IBM_QUANTUM_CRN=your_ibm_instance_crn_here

# IQM Resonance — https://resonance.meetiqm.com
IQM_RESONANCE_TOKEN=your_iqm_token_here
